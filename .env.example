# ─── SQL Server (Profit Plus ERP) ──────────────────────────────────────
DB_SERVER=192.168.1.x
DB_PORT=1433
DB_NAME=ProfitPlusDB
DB_USER=readonly_user
DB_PASSWORD=changeme
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ─── DW_Profit (nightly ETL target, scripts/etl_dw.py) ─────────────────
# Optional overrides — defaults to the DB_SERVER/DB_PORT above with
# DW_NAME defaulting to "DW_Profit" if unset.
# DW_SERVER=192.168.1.x
# DW_PORT=1433
# DW_NAME=DW_Profit

# ─── SQLite (user accounts) ────────────────────────────────────────────
# Dev: relative path is fine.
# Production: use an absolute path OUTSIDE the app directory so the
# database survives redeploys (e.g. C:\data\app.db or /opt/data/app.db).
SQLITE_PATH=./

# ─── Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_EXPIRY_DAYS=7

# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ProfitPlus Exporter
NODE_ENV=development

# ============================================
# MSSQL Docker Mock ERP (for local development)
# Run: docker-compose -f docker/docker-compose.yml up -d
# ============================================
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStr0ngP@ssw0rd
DB_NAME=ProfitPlus
